<Grid
    x:Class="AnalyseAudio.Views.Keyboard.KeyboardElement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:views="using:AnalyseAudio.Views"
    mc:Ignorable="d">

    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Width="auto" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="Keyboard_WaveType" VerticalAlignment="Center" Margin="10,10,0,10" />
        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Bind Path=WavesType}" SelectedItem="{x:Bind Path=WaveType, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,10,0,10" />

        <TextBlock Grid.Row="1" Grid.Column="0" x:Uid="Keyboard_Gain" VerticalAlignment="Center" Margin="10,10,0,10" />
        <views:LogSlider Grid.Row="1" Grid.Column="1" Minimum="0" CenterValue="0.1"  Maximum="1" StepFrequency="0.001" MinWidth="400"  Width="auto" Value="{x:Bind Path=Gain, Mode=TwoWay}"  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,0,10" />
    </Grid>

    <StackPanel x:Name="Whites" Grid.Row="1" Orientation="Horizontal" />
    <StackPanel x:Name="Blacks" Grid.Row="1" Orientation="Horizontal" Margin="0" />

</Grid>
